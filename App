# ======================================================
# CLASES
# ======================================================

class EstadoAcademico:

    def __init__(self):

        self.parcial1 = None
        self.recup1 = None

        self.parcial2 = None
        self.recup2 = None

        self.final = None
        self.recup_final = None


class Profesor:

    def __init__(self, usuario, password, nombre, apellido, dni):

        self.usuario = usuario
        self.password = password
        self.nombre = nombre
        self.apellido = apellido
        self.dni = dni
        self.materias = []

    def mostrar_datos(self):

        return f"{self.nombre} {self.apellido} - DNI: {self.dni}"


class Alumno:

    def __init__(self, usuario, password, nombre, apellido, dni):

        self.usuario = usuario
        self.password = password
        self.nombre = nombre
        self.apellido = apellido
        self.dni = dni

        self.materias = []

        # clave = nombre materia
        self.estados = {}

    def mostrar_datos(self):

        return f"{self.nombre} {self.apellido} - DNI: {self.dni}"


class Materia:

    def __init__(self, nombre):

        self.nombre = nombre
        self.profesor = None
        self.alumnos = []

    # ==================================================
    # PROFESOR
    # ==================================================

    def asignar_profesor(self, profesor):

        self.profesor = profesor
        profesor.materias.append(self)

    # ==================================================
    # ALUMNOS
    # ==================================================

    def inscribir_alumno(self, alumno):

        if alumno not in self.alumnos:

            self.alumnos.append(alumno)
            alumno.materias.append(self)

            alumno.estados[self.nombre] = EstadoAcademico()

            print("Alumno inscrito correctamente")

        else:
            print("El alumno ya está inscrito")

    # ==================================================
    # CARGAR NOTAS
    # ==================================================

    def cargar_notas(self):

        for alumno in self.alumnos:

            estado = alumno.estados[self.nombre]

            print(
                f"\n===== {alumno.nombre} {alumno.apellido} ====="
            )

            # ------------------------------------------
            # PARCIAL 1
            # ------------------------------------------

            if estado.parcial1 is None:

                estado.parcial1 = float(
                    input("Nota Parcial 1: ")
                )

            # RECUPERATORIO 1

            if estado.parcial1 < 4:

                print("Recuperatorio Parcial 1 habilitado")

                estado.recup1 = float(
                    input("Nota Recuperatorio 1: ")
                )

            # ------------------------------------------
            # PARCIAL 2
            # ------------------------------------------

            if estado.parcial2 is None:

                estado.parcial2 = float(
                    input("Nota Parcial 2: ")
                )

            # RECUPERATORIO 2

            if estado.parcial2 < 4:

                print("Recuperatorio Parcial 2 habilitado")

                estado.recup2 = float(
                    input("Nota Recuperatorio 2: ")
                )

            # ------------------------------------------
            # VERIFICAR REGULARIDAD
            # ------------------------------------------

            nota1 = estado.parcial1
            nota2 = estado.parcial2

            if estado.recup1 is not None:
                nota1 = estado.recup1

            if estado.recup2 is not None:
                nota2 = estado.recup2

            # PROMOCIÓN

            if nota1 >= 8 and nota2 >= 8:

                print("El alumno promociona la materia")
                continue

            # DESAPROBADO

            if nota1 < 4 or nota2 < 4:

                print("Alumno desaprobado")
                continue

            # ------------------------------------------
            # FINAL
            # ------------------------------------------

            estado.final = float(
                input("Nota Final: ")
            )

            # RECUPERATORIO FINAL

            if estado.final < 4:

                print("Recuperatorio Final habilitado")

                estado.recup_final = float(
                    input("Nota Recuperatorio Final: ")
                )

    # ==================================================
    # CALCULAR PROMEDIO
    # ==================================================

    def calcular_promedio(self, alumno):

        estado = alumno.estados[self.nombre]

        notas = []

        if estado.parcial1 is not None:
            notas.append(estado.parcial1)

        if estado.parcial2 is not None:
            notas.append(estado.parcial2)

        if estado.final is not None:
            notas.append(estado.final)

        if len(notas) > 0:
            return sum(notas) / len(notas)

        return 0

    # ==================================================
    # ESTADO FINAL
    # ==================================================

    def estado_final(self, alumno):

        estado = alumno.estados[self.nombre]

        nota1 = estado.parcial1
        nota2 = estado.parcial2

        if estado.recup1 is not None:
            nota1 = estado.recup1

        if estado.recup2 is not None:
            nota2 = estado.recup2

        # PROMOCIÓN

        if nota1 >= 8 and nota2 >= 8:
            return "Promociona"

        # DESAPROBADO

        if nota1 < 4 or nota2 < 4:
            return "Desaprobado"

        # FINAL

        if estado.final is not None:

            if estado.final >= 4:
                return "Aprobado"

            else:

                if estado.recup_final is not None:

                    if estado.recup_final >= 4:
                        return "Aprobado por recuperatorio final"

                    else:
                        return "Desaprobado"

                return "Debe rendir recuperatorio final"

        return "Debe rendir final"


